# Test http requests for my api
@apiUrl = http://localhost:3000/api

### Get server root
GET http://localhost:3000/

### Get api root
GET http://localhost:3000/api

##################
## /media requests
##################

### GET all media items
GET {{apiUrl}}/media

### GET 2 media items
GET {{apiUrl}}/media?limit=2

### GET media item by id
GET {{apiUrl}}/media/1

### GET media item by id (Not found)
GET {{apiUrl}}/media/0

### Add new media item WITH IMAGE (form-data)
POST {{apiUrl}}/media
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="title"

New cat image
------Boundary
Content-Disposition: form-data; name="description"

Cute bunny picture
------Boundary
Content-Disposition: form-data; name="user_id"

1
------Boundary
Content-Disposition: form-data; name="file"; filename="bunny.png"
Content-Type: image/png

< ./bunny.png
------Boundary--

### Modify existing media item 
PUT {{apiUrl}}/media/1
content-type: application/json

{
  "description": "Updated description",
  "title": "Updated title"
}

### Delete media item 
DELETE {{apiUrl}}/media/4

##################
## /users requests
##################

### GET all users
GET {{apiUrl}}/users

### GET user by id
GET {{apiUrl}}/users/1

### Add new user
POST {{apiUrl}}/users
content-type: application/json

{
  "username": "TestUser",
  "password": "password123",
  "email": "testuser@example.com",
  "user_level_id": 2
}

### Modify existing user
PUT {{apiUrl}}/users/1
content-type: application/json

{
  "username": "JohnDoeUpdated",
  "password": "newpassword123",
  "email": "johndoe.new@example.com"
}

### Delete user (poistaa äsken luodun käyttäjän, esim. ID 5)
DELETE {{apiUrl}}/users/5

##################
## /likes requests
##################

### GET likes for media item 1
GET {{apiUrl}}/likes/media/1

### GET likes by user 2
GET {{apiUrl}}/likes/user/2

### Add new like
POST {{apiUrl}}/likes
content-type: application/json

{
  "media_id": 1,
  "user_id": 1
}

### Delete like
DELETE {{apiUrl}}/likes/1