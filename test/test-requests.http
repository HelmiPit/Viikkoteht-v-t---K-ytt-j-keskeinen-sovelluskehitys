##################
## /media requests
##################

### GET all media items
GET {{apiUrl}}/media

### GET 3 latest media items
GET {{apiUrl}}/media?limit=1

### GET media item by id
GET {{apiUrl}}/media/2

### GET media item by id (Not found)
GET {{apiUrl}}/media/0

### Add new media item (JSON, no file included!)
POST {{apiUrl}}/media
content-type: application/json

{
  "filename": "60ac.jpg",
  "title": "New image",
  "description": "The description of the new image",
  "user_id": 305,
  "media_type": "image/jpeg"
}

### Add new media item WITH IMAGE (form-data) with token
POST {{apiUrl}}/media
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="title"

New bunny image
------Boundary
Content-Disposition: form-data; name="user_id"

1
------Boundary
Content-Disposition: form-data; name="file"; filename="image.png"
Content-Type: image/jpeg

< ./bunny.png
------Boundary--


### Add new media item (Bad request, title missing)
POST {{apiUrl}}/media
content-type: application/json

{
  "filename": "60ac.jpg",
  "description": "The description of the new image",
  "user_id": 305,
  "media_type": "image/jpeg"
}

### Modify existing media item (not found / unauthorized)
PUT {{apiUrl}}/media/9632
Authorization: Bearer {{login.response.body.token}}
content-type: application/json

{
  "description": "updated desc",
  "title": "Uus title"
}

### Modify own media item (user_id = 2)
PUT {{apiUrl}}/media/2
Authorization: Bearer {{login.response.body.token}}
content-type: application/json

{
  "description": "updated desc",
  "title": "Uus title"
}

### Modify another user's media item as regular user (unauthorized)
PUT {{apiUrl}}/media/1
Authorization: Bearer {{login.response.body.token}}
content-type: application/json

{
  "description": "updated desc",
  "title": "Uus title"
}

### Modify any media item as admin
PUT {{apiUrl}}/media/2
Authorization: Bearer {{loginAdmin.response.body.token}}
content-type: application/json

{
  "description": "admin updated desc",
  "title": "Admin title"
}

### Delete media item (not found / unauthorized)
DELETE {{apiUrl}}/media/13
Authorization: Bearer {{login.response.body.token}}

### Delete own media item
DELETE {{apiUrl}}/media/2
Authorization: Bearer {{login.response.body.token}}

### Delete any media item as admin
DELETE {{apiUrl}}/media/1
Authorization: Bearer {{loginAdmin.response.body.token}}

##################
## /users requests
##################

### GET all users
GET {{apiUrl}}/users
Authorization: Bearer {{login.response.body.token}}

### GET user by id
GET {{apiUrl}}/users/2
Authorization: Bearer {{login.response.body.token}}

### Add new user
POST {{apiUrl}}/users
content-type: application/json

{
  "username": "NewUser",
  "password": "password123",
  "email": "newuser@example.com"
}

### Modify own user info (user_id = 2)
PUT {{apiUrl}}/users/2
Authorization: Bearer {{login.response.body.token}}
content-type: application/json

{
  "username": "JaneSmith",
  "email": "janesmith@example.com",
  "password": "to-be-hashed-pw2"
}

### Modify another user info as regular user (forbidden)
PUT {{apiUrl}}/users/1
Authorization: Bearer {{login.response.body.token}}
content-type: application/json

{
  "username": "HackedAdmin",
  "email": "hack@example.com",
  "password": "123"
}

### Modify any user info as admin
PUT {{apiUrl}}/users/2
Authorization: Bearer {{loginAdmin.response.body.token}}
content-type: application/json

{
  "username": "JaneSmith",
  "email": "janesmith@example.com",
  "password": "to-be-hashed-pw2"
}

### Delete user as admin
DELETE {{apiUrl}}/users/3
Authorization: Bearer {{loginAdmin.response.body.token}}

##################
## Authentication routes
##################

### Post login (regular user)
# @name login
POST {{apiUrl}}/auth/login
content-type: application/json

{
  "username": "JaneSmith",
  "password": "to-be-hashed-pw2"
}

### Post login (admin user)
# @name loginAdmin
POST {{apiUrl}}/auth/login
content-type: application/json

{
  "username": "AdminUser",
  "password": "to-be-hashed-pw4"
}

### Get user info
GET {{apiUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}